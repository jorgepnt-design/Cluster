---
import SectionHead from "./SectionHead.astro";
import { site } from "../config/site";

const services = [
  {
    title: "Clustermanagement as a Service (CMaaS) & Ökosystem-Design",
    points: [
      "Konzeption und Etablierung von Clustern",
      "Formatentwicklung und Moderation: Fachworkshops, Arbeitskreise, Science-to-Business-Transfer",
      "Kommunale Schnittstellen-Kompetenz",
    ],
  },
  {
    title: "High-End Immobilien-Brokerage & Strategische Projektentwicklung",
    points: [
      "Transaktions-Management",
      "Investoren-Ansprache: Family Offices, Private Equity, institutionelle Anleger",
      "Standort- und Potenzialanalyse",
    ],
  },
  {
    title: "Smart City & Quartiersentwicklung",
    points: [
      "Technologie-Sourcing und Pilotierung (Ambient Assisted Living)",
      "Internationaler Transfer",
      "Nachhaltigkeits-Visualisierung",
    ],
  },
];

const usps = ["Immobilienkompetenz", "Kommunale Netzwerke", "Smart Living & Nachhaltigkeit", "Internationale Reichweite"];
---

<section id="ueber" class="scroll-mt-16 py-16 md:py-24" aria-labelledby="ueber-title">
  <div class="container-page">
    <SectionHead num="05" rubric="Über LOC-IN" title="Cluster Management as a Service." id="ueber-title" />

    <div class="mt-12 grid gap-10 lg:grid-cols-[18rem_1fr] lg:gap-14">
      <div>
        <!-- PLATZHALTER: Foto von Nicole Da Costa Pinto unter public/images/nicole-da-costa-pinto.jpg ablegen und hier einbinden -->
        <div
          class="flex aspect-[4/5] w-full max-w-[18rem] flex-col items-center justify-center border border-dashed border-grey bg-grey-bg p-6 text-center"
          role="img"
          aria-label="Platzhalter für ein Porträtfoto von Nicole Da Costa Pinto"
        >
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="var(--grey)" stroke-width="1.3" aria-hidden="true">
            <circle cx="20" cy="15" r="7"></circle>
            <path d="M6 36c2-8 8-12 14-12s12 4 14 12"></path>
          </svg>
          <p class="mt-3 text-xs text-grey-strong">Foto folgt</p>
        </div>
        <p class="mt-4 font-serif text-lg">{site.person}</p>
        <p class="text-sm text-grey-strong">LOC-IN – {site.claim}</p>
      </div>

      <div>
        <p class="max-w-3xl text-lg">
          Cluster- und Ökosystem-Managerin mit <strong class="font-semibold">13 Jahren Praxis</strong> an der Schnittstelle von
          Immobilien, Innovation und Wirtschaftsförderung. <strong class="font-semibold">Mehr als 11 aufgebaute Netzwerke</strong>,
          unter anderem in Biotechnologie, Nachhaltigkeit und Smart City. Direkter Zugang zu Verwaltung und Politik im
          Rhein-Main-Gebiet.
        </p>

        <blockquote class="mt-8 max-w-3xl border-l-2 border-green pl-5">
          <p class="font-serif text-xl italic leading-snug sm:text-2xl">
            „Ich spreche die Sprache aller relevanten Stakeholder – von internationalen Investoren bis hin zu kommunalen
            Entscheidungsträgern.“
          </p>
          <footer class="mt-3 text-sm text-grey-strong">— {site.person}</footer>
        </blockquote>

        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Schwerpunkte">
          {usps.map((u) => <li class="border border-green-line bg-green-soft px-3 py-1.5 text-sm text-green-dark">{u}</li>)}
        </ul>
      </div>
    </div>

    <h3 class="mt-16 text-2xl">Leistungsbereiche</h3>
    <ul class="mt-6 grid gap-5 md:grid-cols-3">
      {
        services.map((s, i) => (
          <li class="border-t-2 border-green bg-grey-bg p-6">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-grey-strong">{String(i + 1).padStart(2, "0")}</p>
            <h4 class="mt-2 text-lg">{s.title}</h4>
            <ul class="mt-4 space-y-2 text-[0.95rem]">
              {s.points.map((p) => (
                <li class="flex gap-2">
                  <span class="mt-[0.6em] h-px w-3 flex-none bg-green" aria-hidden="true" />
                  {p}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
