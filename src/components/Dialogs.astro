---
import { forms, site } from "../config/site";
import { url } from "../lib/cities";
---

<dialog class="modal" id="buy-dialog" aria-labelledby="buy-dialog-title">
  <div class="border-b border-grey-line px-6 py-4 flex items-start justify-between gap-4">
    <div>
      <p class="rubric">Bestellung</p>
      <h2 id="buy-dialog-title" class="mt-2 text-xl" data-slot="title">Standort-Snapshot</h2>
    </div>
    <form method="dialog">
      <button class="flex h-9 w-9 items-center justify-center border border-grey-line hover:bg-grey-bg" aria-label="Schließen">
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </form>
  </div>
  <div class="px-6 py-5">
    <p class="font-medium">Der Online-Kauf wird in Kürze freigeschaltet.</p>
    <p class="mt-2 text-grey-strong">
      Jetzt per E-Mail bestellen: Sie erhalten das PDF zusammen mit einer Rechnung (inkl. ausgewiesener USt.) per E-Mail.
    </p>
    <p class="mt-4 border-l-2 border-green-line pl-3 text-sm">
      <span class="text-grey-strong">Preis:</span> <span data-slot="price"></span>
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" data-slot="mailto" href={`mailto:${site.email}`}>Jetzt per E-Mail bestellen</a>
      <form method="dialog"><button class="btn btn-secondary w-full">Abbrechen</button></form>
    </div>
    <p class="mt-5 text-xs text-grey-strong">
      {site.b2bNote} Es gelten die <a class="link" href={url("/agb")}>AGB</a>.
    </p>
  </div>
</dialog>

<dialog class="modal" id="soon-dialog" aria-labelledby="soon-dialog-title" data-email={site.email}>
  <div class="border-b border-grey-line px-6 py-4 flex items-start justify-between gap-4">
    <div>
      <p class="rubric">Kostenloser Teaser</p>
      <h2 id="soon-dialog-title" class="mt-2 text-xl" data-slot="title">Teaser</h2>
    </div>
    <form method="dialog">
      <button class="flex h-9 w-9 items-center justify-center border border-grey-line hover:bg-grey-bg" aria-label="Schließen">
        <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </form>
  </div>
  <div class="px-6 py-5">
    <p class="font-medium">Der Teaser ist in Kürze verfügbar.</p>
    <p class="mt-2 text-grey-strong">
      Schreiben Sie uns eine kurze E-Mail – wir senden Ihnen den Teaser, sobald er bereitsteht.
    </p>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row">
      <a class="btn btn-primary" data-slot="mailto" href={`mailto:${site.email}`}>Teaser per E-Mail anfordern</a>
      <form method="dialog"><button class="btn btn-secondary w-full">Schließen</button></form>
    </div>
  </div>
</dialog>

{
  forms.teaserLeadEndpoint && (
    <dialog class="modal" id="teaser-dialog" aria-labelledby="teaser-dialog-title">
      <div class="border-b border-grey-line px-6 py-4 flex items-start justify-between gap-4">
        <div>
          <p class="rubric">Kostenloser Teaser</p>
          <h2 id="teaser-dialog-title" class="mt-2 text-xl" data-slot="title">
            Teaser
          </h2>
        </div>
        <form method="dialog">
          <button class="flex h-9 w-9 items-center justify-center border border-grey-line hover:bg-grey-bg" aria-label="Schließen">
            <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>
        </form>
      </div>
      <form class="px-6 py-5" data-teaser-form action={forms.teaserLeadEndpoint} method="post">
        <input type="hidden" name="stadt" value="" />
        <label class="label" for="teaser-email">
          Geschäftliche E-Mail-Adresse
        </label>
        <input class="field" id="teaser-email" name="email" type="email" required autocomplete="email" />
        <label class="mt-4 flex items-start gap-3 text-sm">
          <input type="checkbox" name="newsletter" value="ja" class="mt-1 h-4 w-4 flex-none accent-[var(--green-dark)]" />
          <span>
            Ja, ich möchte gelegentlich per E-Mail über neue Analysen informiert werden. Die Einwilligung kann ich jederzeit
            widerrufen. (optional)
          </span>
        </label>
        <p class="mt-3 text-xs text-grey-strong">
          Ihre E-Mail-Adresse verwenden wir für die Bereitstellung des Teasers. Details in der{" "}
          <a class="link" href={url("/datenschutz")}>Datenschutzerklärung</a>.
        </p>
        <div class="mt-5">
          <button class="btn btn-primary" type="submit">
            Teaser herunterladen
          </button>
        </div>
        <p class="mt-4 text-sm" data-slot="status" role="status" aria-live="polite" />
      </form>
    </dialog>
  )
}

<script>
  const buy = document.getElementById("buy-dialog") as HTMLDialogElement | null;
  const teaser = document.getElementById("teaser-dialog") as HTMLDialogElement | null;
  const soon = document.getElementById("soon-dialog") as HTMLDialogElement | null;

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;

    const buyBtn = target.closest<HTMLElement>("[data-buy-dialog]");
    if (buyBtn && buy) {
      buy.querySelector("[data-slot=title]")!.textContent = buyBtn.dataset.title ?? "";
      buy.querySelector("[data-slot=price]")!.textContent = buyBtn.dataset.price ?? "";
      (buy.querySelector("[data-slot=mailto]") as HTMLAnchorElement).href = buyBtn.dataset.mailto ?? "";
      buy.showModal();
      return;
    }

    const soonBtn = target.closest<HTMLElement>("[data-soon-dialog]");
    if (soonBtn && soon) {
      const city = soonBtn.dataset.city ?? "";
      soon.querySelector("[data-slot=title]")!.textContent = `Teaser ${city}`;
      (soon.querySelector("[data-slot=mailto]") as HTMLAnchorElement).href =
        `mailto:${soon.dataset.email}?subject=${encodeURIComponent(`Teaser ${city} anfordern`)}`;
      soon.showModal();
      return;
    }

    const teaserBtn = target.closest<HTMLElement>("[data-teaser-dialog]");
    if (teaserBtn && teaser) {
      teaser.querySelector("[data-slot=title]")!.textContent = `Teaser ${teaserBtn.dataset.city}`;
      const form = teaser.querySelector<HTMLFormElement>("[data-teaser-form]")!;
      form.dataset.href = teaserBtn.dataset.href;
      (form.elements.namedItem("stadt") as HTMLInputElement).value = teaserBtn.dataset.city ?? "";
      form.querySelector("[data-slot=status]")!.textContent = "";
      teaser.showModal();
    }
  });

  // Klick auf den abgedunkelten Hintergrund schließt das Fenster
  [buy, teaser, soon].forEach((d) =>
    d?.addEventListener("click", (e) => {
      if (e.target === d) d.close();
    }),
  );

  const teaserForm = teaser?.querySelector<HTMLFormElement>("[data-teaser-form]");
  teaserForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const status = teaserForm.querySelector("[data-slot=status]")!;
    status.textContent = "Wird gesendet …";
    try {
      const res = await fetch(teaserForm.action, {
        method: "POST",
        body: new FormData(teaserForm),
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(String(res.status));
    } catch {
      // Download trotzdem ermöglichen – der Lead geht dann ggf. verloren
    }
    status.innerHTML = "";
    const a = document.createElement("a");
    a.href = teaserForm.dataset.href ?? "#";
    a.className = "link";
    a.setAttribute("download", "");
    a.textContent = "Vielen Dank. Download startet – falls nicht, hier klicken.";
    status.append(a);
    a.click();
  });
</script>
