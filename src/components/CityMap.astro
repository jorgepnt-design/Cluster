---
/** Schematische Karte mit einem Punkt je Stadt. Punkte verlinken auf die Detailseiten. */
import { coords, rivers, projector, pathFrom } from "../lib/geo";
import { cities, url } from "../lib/cities";

const box = { latMin: 47.6, latMax: 53.95, lonMin: 5.7, lonMax: 13.85 };
const { project, width, height } = projector(box, 360);
const pad = 10;
---

<figure class="border border-grey-line bg-grey-bg p-4">
  <svg viewBox={`${-pad} ${-pad} ${width + pad * 2} ${height + pad * 2}`} class="h-auto w-full" role="group" aria-labelledby="map-caption">
    {
      Object.values(rivers).map((pts) => (
        <path d={pathFrom(pts.map(project))} fill="none" stroke="var(--green-line)" stroke-width="2.5" stroke-linecap="round" />
      ))
    }
    {
      cities.map((c) => {
        const [x, y] = project(coords[c.slug]);
        const right = x < width * 0.62;
        return (
          <a href={url(`/staedte/${c.slug}`)} class="map-dot" data-map-dot={c.slug} aria-label={`${c.name}, ${c.region}`}>
            <circle cx={x} cy={y} r="9" fill="transparent" />
            <circle cx={x} cy={y} r="3.6" class="dot" />
            <text x={right ? x + 8 : x - 8} y={y + 3.5} text-anchor={right ? "start" : "end"} class="lbl">
              {c.name}
            </text>
          </a>
        );
      })
    }
  </svg>
  <figcaption id="map-caption" class="mt-2 text-xs text-grey-strong">
    Schematische Lage der 39 Städte. Punkt wählen für die Detailseite.
  </figcaption>
</figure>

<style>
  .map-dot .dot {
    fill: var(--green-dark);
    stroke: #fff;
    stroke-width: 1;
    transition: r 0.15s;
  }
  .map-dot .lbl {
    font-size: 11px;
    font-family: var(--font-sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: #fff;
    stroke-width: 3px;
    opacity: 0;
    pointer-events: none;
  }
  .map-dot:hover .lbl,
  .map-dot:focus-visible .lbl {
    opacity: 1;
  }
  .map-dot:hover .dot,
  .map-dot:focus-visible .dot {
    r: 5.5;
    fill: var(--ink);
  }
  .map-dot:focus-visible {
    outline: none;
  }
  .map-dot.is-dimmed .dot {
    fill: var(--grey-line);
    stroke: none;
  }
</style>
