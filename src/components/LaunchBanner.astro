---
import { launch, site } from "../config/site";
---

{
  launch.comingSoon && (
    <div class="border-b border-green-line bg-green-soft text-green-dark" role="note">
      <p class="container-page flex flex-wrap items-center justify-center gap-x-2 gap-y-1 py-2.5 text-center text-sm">
        <span class="font-semibold">{launch.notice}</span>
        <span>
          Anfragen und Vorbestellungen schon jetzt per E-Mail:{" "}
          <a class="font-medium underline underline-offset-2" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </span>
      </p>
    </div>
  )
}
