---
import { url } from "../lib/cities";

const nav = [
  { href: url("/#analysen"), label: "Analysen" },
  { href: url("/#methodik"), label: "Methodik" },
  { href: url("/#ueber"), label: "Über LOC-IN" },
  { href: url("/#kontakt"), label: "Kontakt" },
];
---

<header class="sticky top-0 z-40 border-b border-grey-line bg-white/95 backdrop-blur-sm">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={url("/")} class="flex items-baseline gap-2.5 no-underline" aria-label="LOC-IN – zur Startseite">
      <span class="font-serif text-xl font-semibold tracking-wide text-ink">LOC-IN</span>
      <span class="hidden text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-grey-strong sm:inline">
        Cluster Intelligence
      </span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[0.925rem]">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-ink no-underline hover:text-green-dark hover:underline underline-offset-4 decoration-green-line">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={url("/#analysen")} class="btn btn-primary btn-sm hidden xs:inline-flex">Städte ansehen</a>

      <details class="group relative md:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center border border-grey-line [&::-webkit-details-marker]:hidden"
          aria-label="Menü"
        >
          <svg width="18" height="12" viewBox="0 0 18 12" aria-hidden="true" class="group-open:hidden">
            <path d="M0 1h18M0 6h18M0 11h18" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="hidden group-open:block">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </summary>
        <nav aria-label="Mobile Navigation" class="absolute right-0 top-12 w-60 border border-grey-line bg-white p-2">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} class="block px-3 py-2.5 text-ink no-underline hover:bg-grey-bg">
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li class="xs:hidden">
              <a href={url("/#analysen")} class="block px-3 py-2.5 font-medium text-green-dark no-underline hover:bg-grey-bg">
                Städte ansehen
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Mobiles Menü nach Klick auf einen Link schließen
  document.querySelectorAll<HTMLDetailsElement>("header details").forEach((d) => {
    d.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) d.open = false;
    });
  });
</script>
