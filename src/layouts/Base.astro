---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Dialogs from "../components/Dialogs.astro";
import { site } from "../config/site";
import { shop } from "../config/shop";
import { url } from "../lib/cities";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "product" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, ogType = "website", jsonLd, noindex = false } = Astro.props;
const fullTitle = title.includes("LOC-IN") ? title : `${title} · LOC-IN`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url("/og-image.png"), Astro.site).href;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#3e5644" />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="LOC-IN – European Cluster Intelligence" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {shop.provider === "lemonsqueezy" && <script is:inline src="https://app.lemonsqueezy.com/js/lemon.js" defer />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:border focus:border-green-dark"
    >
      Zum Inhalt springen
    </a>
    <Header />
    <main id="inhalt" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Dialogs />
  </body>
</html>
